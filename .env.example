[TEMPLATE]
# Copy this file to .env and fill in your values:  copy .env.example .env
# All three secrets below stay OUT of source code and git history.

# 1) Groq API key 
GROQ_API_KEY=your_groq_api_key_here

# 2) JWT signing secret for login sessions — any long random string.
#    Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string

# 3) MongoDB connection string.
#    Local dev: install MongoDB Community Server and keep the default.
#    Free cloud: create a cluster at mongodb.com/atlas and paste its URI.
MONGODB_URI=mongodb://localhost:27017

